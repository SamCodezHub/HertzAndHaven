{
  "name": "elderly-accident-prevention-101",
  "version": "1.0.2",
  "productName": "Hertz & Haven",
  "description": "Hertz & Haven phone app for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build:web": "echo The phone app is loaded directly from the app folder.",
    "build": "npm run build:windows",
    "build:windows": "npx --yes electron-builder@25.1.8 --win nsis --x64 --publish never"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "build": {
    "appId": "app.hertzandhaven.desktop",
    "productName": "Hertz & Haven",
    "asar": true,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../app",
        "to": "phone-app",
        "filter": [
          "index.html",
          "app.js",
          "styles.css",
          "new_logo_mark.jpg",
          "manifest.webmanifest",
          "icon.svg"
        ]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Hertz-Haven-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Hertz & Haven"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0"
  }
}
