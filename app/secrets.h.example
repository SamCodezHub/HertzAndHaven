#pragma once

// Copy this file to secrets.h and fill in your values before uploading.
#define WIFI_SSID "YOUR_WIFI_NAME"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// Use the https://...workers.dev address printed by `wrangler deploy`, without a trailing slash.
#define SENSOR_ENDPOINT "https://YOUR-WORKER.workers.dev"
#define SENSOR_DEVICE_ID "machine-01"
#define SENSOR_WRITE_TOKEN "PASTE_THE_WORKER_WRITE_TOKEN_HERE"

// Paste the PEM root CA certificate that verifies the HTTPS certificate for
// SENSOR_ENDPOINT. Keep certificate verification enabled; do not use setInsecure().
static const char SENSOR_ROOT_CA[] PROGMEM = R"PEM(
-----BEGIN CERTIFICATE-----
PASTE_ROOT_CA_CERTIFICATE_HERE
-----END CERTIFICATE-----
)PEM";
